{
  "name": "kouryu-captions",
  "main": "src/index.js",
  "account_id": "78671eff571039eacb434186eb34002a",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "USER_LIMIT",
      "namespace_id": "903001",
      "simple": {
        "limit": 25,
        "period": 60
      }
    },
    {
      "name": "IP_LIMIT",
      "namespace_id": "903002",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "EXPLAIN_LIMIT",
      "namespace_id": "903003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DISCOVERY_LIMIT",
      "namespace_id": "903004",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "logpush": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "ANALOGIES",
        "class_name": "AnalogyCache"
      },
      {
        "name": "TERM_DICTIONARY",
        "class_name": "TermDictionary"
      }
    ]
  },
  "migrations": [
    {
      "tag": "analogy-v1",
      "new_sqlite_classes": [
        "AnalogyCache"
      ]
    },
    {
      "tag": "dictionary-v1",
      "new_sqlite_classes": [
        "TermDictionary"
      ]
    }
  ]
}
